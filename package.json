  "devDependencies": {
    "concurrently": "^5.2.0",
    "nodemon": "^2.0.12"
  },
  "dependencies": {
    "body-parser": "^1.20.4",
    "cors": "^2.8.5",
    "dotenv": "^8.2.0",
    "express": "^4.22.1",
    "if-env": "^1.0.4",
    "mongoose": "^6.13.6",
    "morgan": "^1.9.1",
    "node-schedule": "^1.3.2",
    "pg": "^8.5.1"
  }
